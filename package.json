{
  "name": "build-bro-acceptance",
  "version": "0.1.0",
  "description": "Acceptance tests for Build Bruh: Playwright against a live API and UI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "mariadb": "3.5.5",
    "typescript": "6.0.3"
  }
}
